<?xml version="1.0" encoding="UTF-8"?>
<svg width="1024" height="1024" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
  <!-- White background -->
  <rect width="1024" height="1024" fill="#FFFFFF"/>
  
  <!-- Centered "S" letter -->
  <text
    x="50%"
    y="50%"
    font-family="sans-serif"
    font-size="600"
    font-weight="900"
    fill="#24A1DE"
